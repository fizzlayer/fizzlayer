FROM public.ecr.aws/docker/library/rust:1.94-bookworm AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY api ./api
COPY supabase/compute/fizz-worker/src/protocol.rs supabase/compute/fizz-worker/src/protocol.rs
RUN cargo build --release --locked --bin fizz-serve --jobs 2

FROM public.ecr.aws/docker/library/debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /build/target/release/fizz-serve /usr/local/bin/fizz-serve
COPY public /app/public
ENV FIZZ_PUBLIC_DIR=/app/public
ENV PORT=8080
USER 65532:65532
EXPOSE 8080
CMD ["fizz-serve"]
