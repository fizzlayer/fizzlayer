# Example environment for deploy/compose.yml. Do not put real secrets here.
# Generate them with scripts/selfhost-init.sh (writes .env next to compose.yml
# when the script is not inside a checkout). Placeholders below are not usable.

# local starts Postgres, GoTrue, and PostgREST. Leave empty to use Supabase Cloud.
COMPOSE_PROFILES=local

# Browser origin of this instance.
PUBLIC_URL=http://localhost:8080
API_PORT=8080
WORKER_PORT=8081
MQTT_PORT=1883

# Postgres. The init script fills these.
POSTGRES_PASSWORD=replace-me
AUTHENTICATOR_PASSWORD=replace-me
JWT_SECRET=replace-me
# HS256 service-role JWT signed with JWT_SECRET. The API and worker send this to PostgREST.
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Optional anon JWT. Not sent to the browser. Kept so a gateway can be added later.
ANON_KEY=replace-me
CRON_SECRET=replace-me

# Bundled gateway. For Supabase Cloud, set the project URL and set FIZZ_ALLOW_INSECURE_HTTP=0.
SUPABASE_URL=http://gateway:8000
SUPABASE_PUBLIC_URL=http://localhost:8080
FIZZ_ALLOW_INSECURE_HTTP=1
# Browser OAuth is proxied through the API to GoTrue. Leave empty on Supabase Cloud.
FIZZ_AUTH_UPSTREAM=http://auth:9999

# Host header the API accepts. localhost is already allowed. Comma-separated.
FIZZ_PUBLIC_HOST=localhost:8080
# http for the default port. https when TLS terminates on this host.
FIZZ_PUBLIC_SCHEME=http

# Advertised by GET /api/stream. The worker publishes plain MQTT on 1883.
FIZZ_STREAM_URL=http://localhost:8081
FIZZ_MQTT_TCP_URL=mqtt://localhost:1883
MQTT_TCP_PORT=1883
FIZZ_STREAM_ORIGINS=http://localhost:8080

# Email sign-up. true skips the confirmation link so the stack runs without SMTP.
MAILER_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Fizzlayer

# Optional GitHub and Google OAuth. Callback is ${PUBLIC_URL}/auth/v1/callback.
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Optional Fizz chat. Leave unset and chat returns 503 with a configuration message.
# Ollama example (model must support JSON mode):
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=llama3.1
# OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# Optional. Voice, phone calls, and paid checkout stay off when these are empty.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AGENTPHONE_API_KEY=
AGENTPHONE_AGENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TINKERER=
STRIPE_PRICE_PRO=

# Published images. Defaults are fizzlayer/fizzlayer-api:latest and
# fizzlayer/fizzlayer-worker:latest. Override to pin a sha tag or use GHCR:
# FIZZ_API_IMAGE=ghcr.io/fizzlayer/fizzlayer-api:latest
# FIZZ_WORKER_IMAGE=ghcr.io/fizzlayer/fizzlayer-worker:latest
FIZZ_API_IMAGE=
FIZZ_WORKER_IMAGE=

# Seconds between in-process alert scans. Minimum 15. Default 60.
FIZZ_CRON_SECONDS=60

# Optional TLS profile: add tls to COMPOSE_PROFILES (local,tls).
# FIZZ_ACME_EMAIL=internal uses a local certificate. A real address asks
# Let's Encrypt for a certificate for FIZZ_DOMAIN. Ports 80 and 443 must
# reach this machine, and PUBLIC_URL must be https://FIZZ_DOMAIN.
# FIZZ_DOMAIN=sensors.example.com
# FIZZ_ACME_EMAIL=you@example.com
