# Optional TLS in front of the API.
# FIZZ_ACME_EMAIL=internal (the default) issues a local certificate.
# Set FIZZ_ACME_EMAIL to a real address and FIZZ_DOMAIN to a public name
# for a Let's Encrypt certificate. Ports 80 and 443 must reach this host.
{$FIZZ_DOMAIN:localhost} {
	tls {$FIZZ_ACME_EMAIL:internal}
	encode gzip
	handle /live/* {
		reverse_proxy worker:8080
	}
	handle {
		reverse_proxy api:8080
	}
}
