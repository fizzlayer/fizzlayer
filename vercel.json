{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash scripts/build-frontend.sh",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "api/cron.rs": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "fizz-zeta.vercel.app"
        }
      ],
      "destination": "https://fizzlayer.com/:path",
      "permanent": true
    },
    {
      "source": "/sensors.html",
      "destination": "/sensors",
      "permanent": true
    },
    {
      "source": "/docs.html",
      "destination": "/sensors/docs",
      "permanent": true
    },
    {
      "source": "/agents.html",
      "destination": "/sensors/agents",
      "permanent": true
    },
    {
      "source": "/self-host.html",
      "destination": "/sensors/self-host",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html",
      "permanent": true
    },
    {
      "source": "/status",
      "destination": "/status.html",
      "permanent": true
    },
    {
      "source": "/enterprise",
      "destination": "/enterprise.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/webmcp",
      "destination": "/.well-known/webmcp.json"
    },
    {
      "source": "/api/waitlist",
      "destination": "/api/contact"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co ws://localhost:8080 http://localhost:8080 ws://127.0.0.1:8080 http://127.0.0.1:8080; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), tools=(self), microphone=(self), geolocation=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/.well-known/(webmcp|webmcp.json|mcp.json|ai-plugin.json|mcp/server-card.json)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
